# Configures the source once for every dashboard visitor.
GITHUB_REPOSITORY = "YOUR_OWNER/YOUR_REPOSITORY"
GITHUB_REF = "main"
GITHUB_CHECKPOINT_PATH = "checkpoints"
GITHUB_POLICY_MODE = "final"
MAX_CHECKPOINT_MB = 64
# Enables private-repository access and higher authenticated rate limits.
# GITHUB_TOKEN = "YOUR_READ_ONLY_GITHUB_TOKEN"
